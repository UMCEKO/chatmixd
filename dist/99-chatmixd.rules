# Grant the active logged-in user access to SteelSeries hidraw nodes for
# chatmixd. 0x1038 = SteelSeries USB vendor ID. TAG+="uaccess" makes systemd-
# logind put an ACL on the device for whoever owns the current graphical
# session, so no static group membership (e.g. `audio`) is required.
#
# The single rule covers both the read-only report node and the Arctis Nova
# Pro write node (idProduct 12e0) used for the init sequence, since uaccess
# grants read+write.
KERNEL=="hidraw*", ATTRS{idVendor}=="1038", TAG+="uaccess"
