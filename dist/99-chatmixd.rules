# Allow audio-group users to read SteelSeries hidraw nodes for chatmixd.
# 0x1038 = SteelSeries USB vendor ID.
KERNEL=="hidraw*", ATTRS{idVendor}=="1038", MODE="0640", GROUP="audio"

# Arctis Nova Pro (idProduct=12e0) needs write access for the init sequence.
KERNEL=="hidraw*", ATTRS{idVendor}=="1038", ATTRS{idProduct}=="12e0", MODE="0660", GROUP="audio"
